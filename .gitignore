# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# IDE dirs
.idea/

# Local demo environment state (Temporal dev server db, logs, worker pid)
.demo/

# Private interview/presentation prep material (never push to remote:
# rehearsal notes, deck, planning docs, challenge prompt). Interviewers
# must not see this in the repo. Present with this folder open locally,
# but keep it out of every commit.
_prep/
